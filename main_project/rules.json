[
  {
    "rule_name": "Failed Login Spike",
    "event_type": "failed_login",
    "threshold": 5,
    "interval_seconds": 60,
    "description": "Multiple failed logins from the same host in a short period."
  },
  {
    "rule_name": "High Error Rate",
    "event_type": "error",
    "threshold": 10,
    "interval_seconds": 60,
    "description": "Spike in system errors from a single host."
  },
  {
    "rule_name": "Rapid Page Views",
    "event_type": "page_view",
    "threshold": 15,
    "interval_seconds": 60,
    "description": "Abnormally high number of page views from a single host."
  },
  {
    "rule_name": "Suspicious File Access",
    "event_type": "file_access",
    "threshold": 5,
    "interval_seconds": 60,
    "description": "Frequent file access operations from a single host."
  },
  {
    "rule_name": "High API Request Volume",
    "event_type": "api_request",
    "threshold": 20,
    "interval_seconds": 60,
    "description": "High volume of API requests from a single host."
  },
  {
    "rule_name": "Multiple Successful Logins",
    "event_type": "successful_login",
    "threshold": 5,
    "interval_seconds": 60,
    "description": "Multiple successful logins in a short timeframe."
  }
]
